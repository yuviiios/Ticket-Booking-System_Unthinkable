{
  "name": "ticket-booking-system",
  "version": "1.0.0",
  "description": "High-demand event ticket booking platform with waitlist and QR tickets",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
